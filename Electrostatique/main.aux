\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces \textbf  {En haut à gauche :} Effet de pointe autour d'un arbre. Les équipotentielles sont représentées, ainsi que le champ électrique qui est perpendiculaire aux équipotentielles et d'autant plus important que celles-ci sont resserrées. \textbf  {En haut à droite :} photo d'un arbre à fèves Tonka. \textbf  {En bas :} observations faites par les scientifiques. Les arbres à fève Tonka sont plus hauts, et attirent la foudre qui les débarrasse de leurs voisins et des lianes. }}{9}{figure.3.5}\protected@file@percent }
\newlabel{fig:effet_pointe}{{3.5}{9}{\textbf {En haut à gauche :} Effet de pointe autour d'un arbre. Les équipotentielles sont représentées, ainsi que le champ électrique qui est perpendiculaire aux équipotentielles et d'autant plus important que celles-ci sont resserrées. \textbf {En haut à droite :} photo d'un arbre à fèves Tonka. \textbf {En bas :} observations faites par les scientifiques. Les arbres à fève Tonka sont plus hauts, et attirent la foudre qui les débarrasse de leurs voisins et des lianes}{figure.3.5}{}}
